# Copy to .env.local. Only the two NEXT_PUBLIC_ values ever reach the browser.

# Sanity — from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read token (Viewer role). Only needed for draft previews and the seed script;
# published content is readable without it.
SANITY_API_READ_TOKEN=

# Write token (Editor role). Only used by `npm run seed`. Never set in Vercel.
SANITY_API_WRITE_TOKEN=

# Shared secret pasted into the Sanity webhook. /api/revalidate rejects anything
# whose signature does not verify against this.
SANITY_WEBHOOK_SECRET=

# Instagram — long-lived token from the Instagram API with Instagram Login flow.
# Server-side only. Expires ~60 days; /api/ig-refresh extends it.
INSTAGRAM_ACCESS_TOKEN=

# Shared secret for the ig-refresh cron endpoint (Vercel sets this header itself
# when you use vercel.json crons, but set it so the route can be called safely).
CRON_SECRET=

# Canonical origin, used for metadata, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
